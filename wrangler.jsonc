{
  // VendorTrak — Cloudflare Workers app.
  // Local dev: `npm run db:migrate` then `npm run dev` (D1 + R2 are emulated on disk
  // under .wrangler/state — no cloud account needed).
  // Deploy: create a D1 database (`wrangler d1 create vendortrak`), paste its id below,
  // create the R2 bucket (`wrangler r2 bucket create vendortrak-reports`), then
  // `npm run db:migrate:remote && npm run deploy`.
  "name": "vendortrak",
  "main": "src/index.tsx",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vendortrak",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "vendortrak-reports"
    }
  ],
  "triggers": {
    // Daily at 06:00 UTC: generate visits from routines, then expire overdue tasks
    // (replaces the two separate Vercel crons).
    "crons": ["0 6 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
